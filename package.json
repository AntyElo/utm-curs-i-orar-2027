{
  "name": "fcim-schedule",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "parser": "tsx scripts/parser-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "typecheck:publisher": "tsc -p tools/md-publisher/tsconfig.json --noEmit",
    "build:publisher": "tsc -p tools/md-publisher/tsconfig.build.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
