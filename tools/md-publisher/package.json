{
  "name": "fcim-md-publisher",
  "version": "1.0.0",
  "private": true,
  "description": "Transport-only FCIM timetable publisher for the Moldova laptop",
  "bin": {
    "md-publisher": "./dist/tools/md-publisher/src/index.js"
  },
